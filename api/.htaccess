# No mod_rewrite. Clients call /api/index.php/<route> (PATH_INFO).
<IfModule mod_setenvif.c>
SetEnvIf Authorization "^(.+)$" HTTP_AUTHORIZATION=$1
</IfModule>

# Debian UserDir only allows GET/POST/OPTIONS. Override for this API so
# PUT/PATCH/DELETE from the SPA (and curl) are not AH01630-denied.
<IfModule mod_authz_core.c>
Require method GET POST PUT PATCH DELETE OPTIONS HEAD
</IfModule>

# Note: UserDir AllowOverride does not include Options, so php_value here is
# ignored / can 500. Raise upload_max_filesize in /etc/php/*/apache2/php.ini
# (see DEPLOYMENT.md). api/.user.ini applies only under CGI/FPM.
